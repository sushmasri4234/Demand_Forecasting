# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_APP=run.py
FLASK_ENV=development

# Database Configuration
# Development (SQLite)
DATABASE_URL=sqlite:///demand_forecasting.db
# Production (PostgreSQL example)
# DATABASE_URL=postgresql://user:password@localhost:5432/demand_forecasting

# Redis Configuration
# Development (local Redis)
REDIS_URL=redis://localhost:6379/0
# Production
# REDIS_URL=redis://:password@redis-host:6379/0

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@demandforecasting.com

# Security Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ARGON2_SECRET_KEY=your-argon2-pepper-key-change-in-production
TOTP_ENCRYPTION_KEY=your-totp-encryption-key-32-bytes

# Session Configuration
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600  # 1 hour in seconds
REMEMBER_COOKIE_DURATION=2592000  # 30 days in seconds

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_ENABLED=True

# reCAPTCHA (optional)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_ENABLED=False  # Set to True to enable

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900  # 15 minutes in seconds
PASSWORD_RESET_TOKEN_EXPIRY=3600  # 1 hour in seconds
EMAIL_VERIFICATION_TOKEN_EXPIRY=3600  # 1 hour in seconds

# HTTPS & Security Headers
FORCE_HTTPS=False  # Set to True in production
HSTS_ENABLED=False  # Set to True in production

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
